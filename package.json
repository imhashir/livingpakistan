{
  "name": "livingpakistan",
  "private": true,
  "version": "1.0.0",
  "description": "living pakistan — Pakistan as a 3D Civilization-style data atlas, built from real public data",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "shots": "node scripts/screenshots.mjs",
    "verify": "node scripts/verify-prod.mjs",
    "video:record": "node scripts/video/record.mjs /tmp/livingpakistan-video/raw",
    "video:compose": ".venv/bin/python scripts/video/compose.py /tmp/livingpakistan-video/raw previews/livingpakistan-demo.mp4"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "playwright": "^1.65.1",
    "three": "^0.187.0",
    "vite": "^8.4.0"
  }
}
